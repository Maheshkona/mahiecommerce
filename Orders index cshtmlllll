<span class="badge @(o.Status == OrderStatus.PENDING ? "badge-pending" :
                     o.Status == OrderStatus.SHIPPED ? "badge-shipped" :
                     o.Status == OrderStatus.DELIVERED ? "badge-delivered" :
                     o.Status == OrderStatus.CANCELLED ? "badge-cancelled" :
                     o.Status == OrderStatus.RETURN_REQUESTED ? "badge-return-requested" :
                     o.Status == OrderStatus.RETURN_SHIPPED ? "badge-return-shipped" :
                     o.Status == OrderStatus.RETURN_DELIVERED ? "badge-return-delivered" :
                     "badge bg-secondary")">
    @o.Status
</span>






<div class="d-flex gap-2">
    @if (o.Status == OrderStatus.DELIVERED)
    {
        <form asp-action="RequestReturn" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@o.Id" />
            <button type="submit" class="btn btn-sm btn-outline-primary">Return</button>
        </form>
    }
    else if (o.Status == OrderStatus.PENDING || o.Status == OrderStatus.SHIPPED)
    {
        <form asp-action="Cancel" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@o.Id" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
        </form>
    }
    <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@o.Id">Details</a>
</div>
